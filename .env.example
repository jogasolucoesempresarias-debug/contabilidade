# Portal Contábil — variáveis de ambiente. Copie para `.env` (local) ou cadastre na stack (prod).
# NUNCA commitar o `.env`.

# ── Flask ──
# production no servidor (aí SECRET_KEY é obrigatória)
FLASK_ENV=
# 32+ caracteres: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── PostgreSQL (um banco por escritório) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_contabil
DB_USER=
DB_PASSWORD=

# ── Marca da instância ──
ESCRITORIO_NOME=Nome do Escritório
# opcional, ex.: #1f5f5b
ESCRITORIO_COR=
# AVISO_DEMO=              # ausente = faixa padrão da demonstração; vazio = sem faixa

# ── Admin inicial (só no 1º init_db; troca a senha no 1º acesso) ──
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=

# ── Acesso de suporte JOGA (não fica no banco; vazio = desligado) ──
SUPORTE_EMAIL=
SUPORTE_SENHA=

# ── OCR / arquivos (o padrão serve; no container já vêm definidos) ──
# TESSDATA_DIR=            # padrão: ./tessdata (modelo por do tessdata_best)
# TESSERACT_CMD=           # padrão: tesseract no PATH ou C:\Program Files\Tesseract-OCR
# DOCS_DIR=                # padrão: ./_dados/docs

# ── Testes ──
# Pasta com documentos reais + esperado.json, FORA do repositório (que é público):
# AMOSTRAS_DIR=../amostras
